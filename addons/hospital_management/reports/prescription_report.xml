<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Report Action -->
    <record id="report_prescription" model="ir.actions.report">
        <field name="name">Prescription</field>
        <field name="model">hospital.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_management.prescription_template</field>
        <field name="report_file">hospital_management.prescription</field>
        <field name="binding_model_id" ref="hospital_management.model_hospital_appointment"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Corrected Prescription Template -->
    <template id="prescription_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Header with optional logo -->
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                            
                            <div style="text-align:right;">
                                <h2 style="margin:0; color:#4a4a8c;">Prescription</h2>
                                <p style="margin:0; font-size:12px; color:#666;">Date: <span t-field="o.date" t-options='{"format": "dd/MM/yyyy"}'/></p>
                            </div>
                        </div>

                        <!-- Patient & Doctor Info -->
                        <table style="width:100%; margin-bottom:20px; border-collapse:collapse;">
                            <tr>
                                <td style="width:50%; padding:5px;"><strong>Patient:</strong> <span t-field="o.patient_id.name"/></td>
                                <td style="width:50%; padding:5px;"><strong>Doctor:</strong> <span t-field="o.doctor_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding:5px;"><strong>Age:</strong> <span t-field="o.patient_id.age"/></td>
                                <td style="padding:5px;"><strong>Department:</strong> <span t-field="o.department_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding:5px;"><strong>Gender:</strong> <span t-field="o.patient_id.gender"/></td>
                                <td style="padding:5px;"><strong>Status:</strong> <span t-esc="dict(o._fields['state'].selection).get(o.state, o.state)"/></td>
                            </tr>
                        </table>

                        <hr style="border:1px solid #ccc; margin:10px 0;"/>

                        <!-- Prescription Section -->
                        <h3 style="color:#4a4a8c; border-bottom:1px solid #ccc; padding-bottom:4px;">Prescription</h3>
                        <div t-field="o.prescription" style="min-height:150px; white-space: pre-wrap; margin-bottom:20px; padding:8px; border:1px solid #ddd; background-color:#f9f9f9;"/>

                        <!-- Additional Notes -->
                        <h3 style="color:#4a4a8c; border-bottom:1px solid #ccc; padding-bottom:4px; margin-top:20px;">Additional Notes</h3>
                        <div t-field="o.notes" style="min-height:100px; white-space: pre-wrap; margin-bottom:20px; padding:8px; border:1px solid #ddd; background-color:#f9f9f9;"/>

                        <!-- Doctor Signature -->
                        <div style="margin-top:30px; display:flex; justify-content:space-between;">
                            <div>
                                <p><strong>Doctor Signature:</strong> ___________________________</p>
                            </div>
                            <div style="text-align:right;">
                                <p><strong>Date:</strong> <span t-field="o.date" t-options='{"format": "dd/MM/yyyy"}'/></p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>