<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Report Action -->
    <record id="report_appointment" model="ir.actions.report">
        <field name="name">Appointment Report</field>
        <field name="model">hospital.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_management.appointment_report_template</field>
        <field name="report_file">hospital_management.appointment_report</field>
        <field name="binding_model_id" ref="hospital_management.model_hospital_appointment"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Report Template -->
    <template id="appointment_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Header -->
                        <h2 style="text-align:center; color:#4a4a8c;">Appointment Details</h2>
                        <hr style="border:1px solid #ccc;"/>

                        <!-- General Info Table -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:15px;">
                            <tr style="background-color:#ADA8E9; font-weight:bold; color:white;">
                                <th style="padding:6px; text-align:left;">Reference</th>
                                <th style="padding:6px; text-align:left;">Date</th>
                                <th style="padding:6px; text-align:left;">Patient</th>
                                <th style="padding:6px; text-align:left;">Doctor</th>
                                <th style="padding:6px; text-align:left;">Department</th>
                                <th style="padding:6px; text-align:left;">Status</th>
                            </tr>
                            <tr style="background-color:#f2f2f2;">
                                <td style="padding:6px;"><span t-field="o.reference"/></td>
                                <td style="padding:6px;"><span t-field="o.date" t-options='{"format": "dd/MM/yyyy HH:mm"}'/></td>
                                <td style="padding:6px;"><span t-field="o.patient_id.name"/></td>
                                <td style="padding:6px;"><span t-field="o.doctor_id.name"/></td>
                                <td style="padding:6px;"><span t-field="o.department_id.name"/></td>
                                <td style="padding:6px;"><span t-esc="dict(o._fields['state'].selection).get(o.state, o.state)"/></td>
                            </tr>
                        </table>

                        <!-- Notes Section -->
                        <h3 style="color:#4a4a8c; border-bottom:1px solid #ccc; padding-bottom:4px;">Notes</h3>
                        <div t-field="o.notes" style="margin-bottom:15px;"/>

                        <!-- Prescription Section -->
                        <h3 style="color:#4a4a8c; border-bottom:1px solid #ccc; padding-bottom:4px;">Prescription</h3>
                        <div t-field="o.prescription" style="margin-bottom:15px;"/>

                        <!-- Treatment Notes Section -->
                        <h3 style="color:#4a4a8c; border-bottom:1px solid #ccc; padding-bottom:4px;">Treatment Notes</h3>
                        <div t-field="o.treatment_notes" style="margin-bottom:15px;"/>

                        <!-- Footer -->
                        <hr style="border:1px dashed #ccc; margin-top:20px;"/>
                        <p style="text-align:right; font-size:10px; color:#666;">
                            Generated on <span t-esc="context_timestamp(datetime.datetime.now())"/>
                        </p>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>